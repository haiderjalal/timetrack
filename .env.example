# Copy to .env.local and fill in. Never commit real values.
# Server-only secrets must NOT start with NEXT_PUBLIC_.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1). Local values come from `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by maintenance code in src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# Google OAuth credentials are configured in Supabase (Auth → Providers → Google), not in the app.

# Email (Phase 2)
RESEND_API_KEY=
EMAIL_FROM=

# Rate limiting (Phase 3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error reporting (Phase 6)
SENTRY_DSN=
